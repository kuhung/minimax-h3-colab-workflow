{
  "ignore": [
    "docs/internal/**",
    "docs/ROADMAP.md",
    "docs/SOTA_PLAN_20261107.md",
    "docs/articles/plan.md",
    "docs/minimax-h3-facts-*.md"
  ],
  "extraDeny": [
    {
      "id": "local-path",
      "pattern": "/Users/kuhung|file:///",
      "level": "error",
      "hint": "禁止在对外仓库出现本机绝对路径或 file:// URI"
    },
    {
      "id": "placeholder-repo",
      "pattern": "your-username",
      "level": "error",
      "hint": "替换为实际公开仓库地址或相对路径"
    },
    {
      "id": "unverified-metrics",
      "pattern": "23\\.95\\s*GB\\+|631\\.2\\s*s|631\\s*秒|1,120\\s*~\\s*3,360|5,600\\s*~\\s*16,800|免费赠送.{0,8}L4",
      "level": "error",
      "hint": "与仓库实测日志或 2026-11-12 核验数据记录不符，禁止写入未实测或已过期承诺"
    },
    {
      "id": "obscure-admin-terms",
      "pattern": "台账",
      "level": "warn",
      "hint": "去掉「台账」等行政/财务生僻词，改用「数据记录」「实测记录」「核验清单」"
    },
    {
      "id": "vague-placeholder",
      "pattern": "xxG|xx%|待补充|待实测|\\[待填\\]",
      "level": "error",
      "hint": "禁止保留模糊占位符，写入实测数字或明确写明未实测边界"
    },
    {
      "id": "section-padding",
      "pattern": "包打天下|混用往往比单押一家更稳|对照就够了|极具颠覆性",
      "level": "warn",
      "hint": "删掉节首垫话、节尾总结套话或武断尾词，直接进入事实与对比"
    },
    {
      "id": "b2b-assumption",
      "pattern": "工业验收|工作室日产|商业制作团队|工业级",
      "level": "warn",
      "hint": "除非选题明确写给企业采购，否则去掉团队/工作室/工业级想象包装，回到个人创作者视角"
    },
    {
      "id": "hype-title-words",
      "pattern": "破局|极速实战|深度拆解|搜塔",
      "level": "warn",
      "hint": "标题与小节用搜得到的直白名词，不使用营销夸张词或生造音译词"
    }
  ]
}
